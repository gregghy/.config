#!/usr/bin/env bash
# distro-bootstrap — one-shot setup for a fresh Arch install.
#
# Run on a base Arch system (after pacstrap/archinstall + user created):
#   curl -fsSL https://raw.githubusercontent.com/gregghy/.config/main/distro/distro-bootstrap | bash
# or, if the repo is already cloned to ~/.config:
#   ~/.config/distro/distro-bootstrap
#
# What it does: clones ~/.config, installs all packages (official + AUR via
# yay), installs nerd fonts, links the distro scripts, restores .bashrc,
# installs herdr, enables timers/services, applies system config (zram,
# power profiles, journal cap, pacman cache policy), switches networking
# to iwd, and brands the OS as 林UX.
set -euo pipefail

C="$HOME/.config"
REPO_HTTPS="https://github.com/gregghy/.config"
REPO_SSH="ssh://git@github.com/gregghy/.config"

info() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
die()  { printf '\033[1;31merror:\033[0m %s\n' "$*" >&2; exit 1; }

[ "$(id -u)" -eq 0 ] && die "run as your normal user, not root"
sudo -v || die "sudo access required"

# ── 1. dotfiles repo ────────────────────────────────────────────────
if [ ! -d "$C/.git" ]; then
    info "Installing git + cloning dotfiles to $C"
    sudo pacman -S --needed --noconfirm git
    git clone "$REPO_HTTPS" "$C" 2>/dev/null \
        || git clone "$REPO_SSH" "$C" \
        || die "clone failed (private repo? set up an SSH key first)"
else
    info "Dotfiles repo already present, pulling latest"
    git -C "$C" pull --ff-only || true
fi

# ── 2. official packages ────────────────────────────────────────────
info "Installing $(wc -l < "$C/pkglist.txt") official packages"
sudo pacman -S --needed --noconfirm - < "$C/pkglist.txt"

# ── 3. AUR via yay ──────────────────────────────────────────────────
if ! command -v yay >/dev/null; then
    info "Bootstrapping yay"
    sudo pacman -S --needed --noconfirm base-devel
    tmp=$(mktemp -d)
    git clone https://aur.archlinux.org/yay-bin.git "$tmp/yay-bin"
    (cd "$tmp/yay-bin" && makepkg -si --noconfirm)
    rm -rf "$tmp"
fi
info "Installing $(wc -l < "$C/pkglist-aur.txt") AUR packages"
yay -S --needed --noconfirm - < "$C/pkglist-aur.txt"

# nchat fork (gregghy/nchat @ custom) — cloned to ~/progetti/nchat,
# built via its own arch/PKGBUILD which sources that clone.
info "Building nchat fork"
mkdir -p "$HOME/progetti"
[ -d "$HOME/progetti/nchat/.git" ] || \
  git clone -b custom https://github.com/gregghy/nchat "$HOME/progetti/nchat"
(cd "$HOME/progetti/nchat/arch" && makepkg -si --noconfirm)

# hyprquickpaper (quickshell coverflow picker — gitignored clone)
QSC="$HOME/.config/quickshell/hyprquickpaper"
if [ ! -d "$QSC/.git" ]; then
    info "Cloning hyprquickpaper"
    mkdir -p "$HOME/.config/quickshell"
    git clone --depth 1 https://github.com/ujjalsigdel/hyprquickpaper "$QSC" || true
fi
if [ -f "$QSC/config.json" ]; then
    sed -i \
        -e "s|\"wallpaper_path\": .*|\"wallpaper_path\": \"$HOME/.config/hypr/\",|" \
        -e 's|"wallpaper_tool": .*|"wallpaper_tool": "awww",|' \
        -e 's|"active_layout": .*|"active_layout": "layouts/shell-coverflow.qml",|' \
        -e 's|"border_color": .*|"border_color": "#83a598",|' \
        "$QSC/config.json"
    chmod +x "$QSC"/*.sh 2>/dev/null || true
    git -C "$QSC" apply "$C/distro/hyprquickpaper-coverflow.patch" 2>/dev/null \
        || echo "  (coverflow restyle patch skipped — stock layout still works)"
fi

# ── 4. fonts (no packages — fetched from upstream releases) ─────────
info "Installing nerd fonts"
mkdir -p "$HOME/.local/share/fonts"
install_font() {
    local dir="$1" url="$2"
    [ -d "$HOME/.local/share/fonts/$dir" ] && return 0
    curl -fsSL "$url" -o "/tmp/$dir.zip"
    unzip -oq "/tmp/$dir.zip" -d "$HOME/.local/share/fonts/$dir"
    rm "/tmp/$dir.zip"
}
install_font MapleMono-NF "https://github.com/subframe7536/maple-font/releases/download/v7.9/MapleMono-NF.zip"
install_font CommitMono   "https://github.com/ryanoasis/nerd-fonts/releases/download/v3.5.1/CommitMono.zip"
fc-cache -f >/dev/null

# ── 5. scripts + bashrc ─────────────────────────────────────────────
info "Linking distro scripts"
mkdir -p "$HOME/.local/bin"
for s in distro-clean distro-clean-root distro-power-setup; do
    ln -sf "$C/distro/$s" "$HOME/.local/bin/$s"
done
sudo install -m755 "$C/distro/distro-clean-root" /usr/local/bin/distro-clean-root

info "Restoring .bashrc (tracked copy, secrets stripped)"
cp "$C/.bashrc_copy" "$HOME/.bashrc"

info "Linking desktop entries"
mkdir -p "$HOME/.local/share/applications"
for d in "$C"/applications/*.desktop; do
    ln -sf "$d" "$HOME/.local/share/applications/$(basename "$d")"
done

# ── 6. herdr (binary, not a package) + devin orchestration skill ────
if ! command -v herdr >/dev/null; then
    info "Installing herdr"
    curl -fL -o "$HOME/.local/bin/herdr" \
        https://github.com/herdrdev/herdr/releases/latest/download/herdr-linux-x86_64
    chmod +x "$HOME/.local/bin/herdr"
fi
mkdir -p "$HOME/.config/devin/skills/herdr"
curl -fsSL -o "$HOME/.config/devin/skills/herdr/SKILL.md" \
    https://raw.githubusercontent.com/herdrdev/herdr/master/skills/herdr/SKILL.md

# ── 7. user units + timers ──────────────────────────────────────────
info "Enabling user services (tracked .wants symlinks)"
systemctl --user daemon-reload
systemctl --user enable --now distro-clean.timer ssh-agent.service 2>/dev/null || true

# ── 8. system config ────────────────────────────────────────────────
info "Applying system config (zram, power profiles, journal cap)"
sudo "$C/distro/distro-power-setup"
sudo "$C/distro/distro-clean-root"

info "Enabling system timers"
sudo systemctl enable --now paccache.timer reflector.timer 2>/dev/null || true

# ── 9. 林UX — iwd networking + branding ─────────────────────────────
if ! systemctl is-enabled --quiet iwd; then
    info "Switching networking to iwd (+ systemd-resolved + networkd)"
    sudo mkdir -p /etc/iwd /etc/systemd/network
    printf '[General]\nEnableNetworkConfiguration=true\n\n[Network]\nNameResolvingService=systemd\n' \
        | sudo tee /etc/iwd/main.conf >/dev/null
    printf '[Match]\nName=en* eth*\n\n[Network]\nDHCP=yes\n' \
        | sudo tee /etc/systemd/network/20-wired.network >/dev/null
    systemctl is-enabled --quiet NetworkManager 2>/dev/null \
        && sudo systemctl disable --now NetworkManager
    sudo systemctl enable --now iwd systemd-resolved systemd-networkd
    sudo ln -sf /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf
fi
if ! grep -q '^NAME="林UX"' /etc/os-release 2>/dev/null; then
    info "Branding OS → 林UX"
    tmp=$(mktemp)
    sed -e 's/^NAME=.*/NAME="林UX"/' \
        -e 's/^PRETTY_NAME=.*/PRETTY_NAME="林UX"/' \
        -e 's/^ANSI_COLOR=.*/ANSI_COLOR="38;2;156;207;216"/' \
        /usr/lib/os-release > "$tmp"
    sudo install -m644 "$tmp" /etc/os-release && rm -f "$tmp"
fi
sudo hostnamectl set-hostname --pretty "林UX" 2>/dev/null || true
gsettings set org.gnome.desktop.interface font-name 'CommitMono Nerd Font 11' 2>/dev/null || true

# ── 10. pkglist pacman hook + plymouth splash + grub branding ───────
info "Root polish (pacman hook, plymouth, grub)"
sudo "$C/distro/distro-linx-polish" || echo "skip (non-fatal)"

echo
info "Bootstrap complete."
cat <<'EOF'

Manual steps left:
  - Wi-Fi:            reconnect once via impala (click the waybar Wi-Fi icon)
  - SSH keys:         copy ~/.ssh from backup, then `systemctl --user restart ssh-agent`
  - gh auth:          `gh auth login`
  - git identity:     git config --global user.name / user.email
  - devin CLI:        official installer from devin.ai
  - opencode:         installer (installs to ~/.opencode)
  - flutter SDK:      ~/progetti/flutter-sdk (or clone it fresh + point PATH in .bashrc)
  - passwords/tokens: re-add secret aliases (e.g. trr) — never committed
EOF
