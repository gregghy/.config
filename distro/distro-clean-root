#!/usr/bin/env bash
# distro-clean-root — system-level cleanup. Run with: sudo distro-clean-root
set -u

info() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
[ "$(id -u)" -ne 0 ] && { echo "error: run with sudo" >&2; exit 1; }

info "Removing orphaned packages"
while pacman -Qtdq >/dev/null 2>&1; do
    pacman -Rns --noconfirm $(pacman -Qtdq)
done

info "Pruning pacman cache to last 2 versions"
paccache -rk2
sed -i 's/^PACCACHE_ARGS=.*/PACCACHE_ARGS=-k2/' /etc/conf.d/pacman-contrib

info "Capping journal at 500M and vacuuming"
mkdir -p /etc/systemd/journald.conf.d
printf '[Journal]\nSystemMaxUse=500M\n' > /etc/systemd/journald.conf.d/50-maxsize.conf
systemctl restart systemd-journald
journalctl --vacuum-size=500M | tail -1

info "Clearing coredumps"
rm -f /var/lib/systemd/coredump/*

if [ -n "${SUDO_USER:-}" ]; then
    info "Enabling linger for $SUDO_USER (user timers run without login)"
    loginctl enable-linger "$SUDO_USER" 2>/dev/null || true
fi

info "Done"
df -h / | awk 'NR==2{print "  disk: "$3" used / "$4" free"}'
