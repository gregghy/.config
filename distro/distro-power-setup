#!/usr/bin/env bash
# distro-power-setup — zram swap + power-profiles-daemon setup.
# Fixes OOM churn (no swap) and enables automatic battery profiles.
# Run with: sudo ~/.local/bin/distro-power-setup
set -eu

info() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
[ "$(id -u)" -ne 0 ] && { echo "error: run with sudo" >&2; exit 1; }

info "Installing packages"
pacman -S --needed --noconfirm zram-generator power-profiles-daemon powertop

info "Configuring zram swap (RAM/2, zstd)"
cat > /etc/systemd/zram-generator.conf <<'EOF'
[zram0]
zram-size = ram / 2
compression-algorithm = zstd
swap-priority = 100
fs-type = swap
EOF

info "Setting swappiness=180 (recommended for zram)"
printf 'vm.swappiness = 180\n' > /etc/sysctl.d/99-zram-swappiness.conf
sysctl -p /etc/sysctl.d/99-zram-swappiness.conf

systemctl daemon-reload
systemctl start systemd-zram-setup@zram0.service

info "Enabling power-profiles-daemon (auto battery saver)"
systemctl enable --now power-profiles-daemon.service

echo
info "Result:"
swapon -s
powerprofilesctl get
