#!/usr/bin/env bash
# distro-clean — user-level cleanup: caches + status report.
# System-level tasks live in distro-clean-root (run with sudo).
set -u

info() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }

info "Clearing AUR build cache"
rm -rf "$HOME/.cache/yay"

info "Clearing pip cache"
command -v pip >/dev/null && pip cache purge -q 2>/dev/null || true

if command -v npm >/dev/null; then
    info "Clearing npm cache"
    npm cache clean --force >/dev/null 2>&1 || true
fi

if [ -d "$HOME/.cache/pre-commit" ]; then
    info "Clearing pre-commit cache"
    rm -rf "$HOME/.cache/pre-commit"
fi

echo
info "Status report"
echo "  disk:      $(df -h / | awk 'NR==2{print $3" used / "$4" free"}')"
echo "  journal:   $(journalctl --disk-usage 2>/dev/null | sed -E 's/.*take up ([^ ]+).*/\1/')"
echo "  orphans:   $(pacman -Qtdq 2>/dev/null | wc -l)"
echo "  coredumps: $(ls /var/lib/systemd/coredump 2>/dev/null | wc -l)"

if pacman -Qtdq >/dev/null 2>&1; then
    echo
    echo "Orphaned packages present — run: sudo distro-clean-root"
fi
