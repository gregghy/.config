#!/usr/bin/env bash
# distro-linx-polish — system-level bits that need root:
#   - pacman hook exporting pkglist.txt/pkglist-aur.txt on every transaction
#   - plymouth 林 boot splash + mkinitcpio hook
#   - GRUB: splash kernel flag + 林UX menu names
# Run: sudo ~/.config/distro/distro-linx-polish
set -euo pipefail
repo="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"

echo "==> Unblocking rfkill radios (bluetooth soft-block breaks bluetui)"
rfkill unblock bluetooth || true

echo "==> pacman hook: auto-export pkglists"
install -d /etc/pacman.d/hooks
cat > /etc/pacman.d/hooks/pkglist-export.hook <<EOF
[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Package
Target = *

[Action]
Description = Exporting pkglists to ~/.config
When = PostTransaction
Exec = $repo/distro/export-pkglists
EOF

if command -v plymouth-set-default-theme >/dev/null; then
	echo "==> Plymouth 林 theme"
	install -Dm644 "$repo/fastfetch/lin-splash.png" /usr/share/plymouth/themes/linx/lin-splash.png
	cat > /usr/share/plymouth/themes/linx/linx.plymouth <<'EOF'
[Plymouth Theme]
Name=linx
Description=Linux splash — ASCII lin art, breathing
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/linx
ScriptFile=/usr/share/plymouth/themes/linx/linx.script
EOF
	cat > /usr/share/plymouth/themes/linx/linx.script <<'EOF'
# gruvbox dark backdrop
Window.SetBackgroundTopColor(0.114, 0.125, 0.129);
Window.SetBackgroundBottomColor(0.098, 0.098, 0.098);

art.image = Image("lin-splash.png");
# fit to ~52% of screen height, never wider than 80% of screen
scale = Window.GetHeight() * 0.52 / art.image.GetHeight();
if (art.image.GetWidth() * scale > Window.GetWidth() * 0.8)
  scale = Window.GetWidth() * 0.8 / art.image.GetWidth();
art.scaled = art.image.Scale(art.image.GetWidth() * scale,
                             art.image.GetHeight() * scale);
art.sprite = Sprite(art.scaled);
art.sprite.SetX(Window.GetWidth()  / 2 - art.scaled.GetWidth()  / 2);
art.sprite.SetY(Window.GetHeight() / 2 - art.scaled.GetHeight() / 2);
art.angle = 0;

fun refresh()
  {
    art.angle += 0.07;
    art.sprite.SetOpacity(0.62 + 0.38 * (Math.Cos(art.angle) + 1) / 2);
  }
Plymouth.SetRefreshFunction(refresh);
EOF
	grep -qE '^HOOKS=.*plymouth' /etc/mkinitcpio.conf || \
		sed -i 's/^HOOKS=(\(.*\)systemd /HOOKS=(\1systemd plymouth /' /etc/mkinitcpio.conf
	plymouth-set-default-theme linx
	mkinitcpio -P
fi

if command -v grub-mkconfig >/dev/null && [ -d /boot/grub ]; then
	echo "==> GRUB: splash flag + 林UX menu names"
	grep -qw splash /etc/default/grub || \
		sed -i 's/^GRUB_CMDLINE_LINUX_DEFAULT="\(.*\)"/GRUB_CMDLINE_LINUX_DEFAULT="\1 splash"/' /etc/default/grub
	sed -i 's/^GRUB_DISTRIBUTOR=.*/GRUB_DISTRIBUTOR="林UX"/' /etc/default/grub
	grub-mkconfig -o /boot/grub/grub.cfg
fi

echo "Done. Reboot for the splash; relog for autostart changes."
