#!/usr/bin/env bash
# Ctrl+Alt+N — night-light toggle with wallpaper sync:
#   on  -> force 6500K AND lock day-mode until the next solar boundary
#   off -> resume auto (sun-driven tint + wallpaper)
# State tracked in a file — hyprsunset runs regardless, so pgrep is useless.
STATE=/tmp/nightlight-on
OVERRIDE=/tmp/daynight-override

pgrep -x hyprsunset >/dev/null || setsid hyprsunset >/dev/null 2>&1 &

if [ -f "$STATE" ]; then
	rm -f "$STATE"
	info=$(gammastep -p 2>&1 | grep 'Period:')
	case "$info" in
		*Night*|*Transition*) echo "forced-day:night" > "$OVERRIDE" ;;
		*) rm -f "$OVERRIDE" ;;
	esac
	hyprctl -q hyprsunset temperature 6500
	notify-send "Night light off — day until dawn" -t 1500
else
	touch "$STATE"
	rm -f "$OVERRIDE"
	notify-send "Night light on" -t 1500
fi
systemctl --user kill -s USR1 daynight 2>/dev/null
