#!/usr/bin/env python3
# Print today's solar boundary times for the gammastep coordinates.
# daynight flips light when elev crosses +3° (Daytime), dark below
# -6° (Night); in between is Transition, which holds the last mode.
import math, re, datetime, pathlib, sys

cfg = pathlib.Path.home() / '.config/gammastep/config.ini'
text = cfg.read_text()
lat = float(re.search(r'^lat=([-\d.]+)', text, re.M).group(1))
lon = float(re.search(r'^lon=([-\d.]+)', text, re.M).group(1))

day = datetime.date.today() + datetime.timedelta(days=int(sys.argv[1]) if len(sys.argv) > 1 else 0)
N = day.timetuple().tm_yday
gamma = 2 * math.pi / 365 * (N - 1 + 0.5)
eqtime = 229.18 * (0.000075 + 0.001868 * math.cos(gamma) - 0.032077 * math.sin(gamma)
                   - 0.014615 * math.cos(2 * gamma) - 0.040849 * math.sin(2 * gamma))
decl = (0.006918 - 0.399912 * math.cos(gamma) + 0.070257 * math.sin(gamma)
        - 0.006758 * math.cos(2 * gamma) + 0.000907 * math.sin(2 * gamma)
        - 0.002697 * math.cos(3 * gamma) + 0.00148 * math.sin(3 * gamma))

def pair(zenith_deg):
    z, la = math.radians(zenith_deg), math.radians(lat)
    c = (math.cos(z) - math.sin(la) * math.sin(decl)) / (math.cos(la) * math.cos(decl))
    if not -1 <= c <= 1:
        return None
    ha = math.degrees(math.acos(c))
    f = lambda m: (datetime.datetime.combine(day, datetime.time(), tzinfo=datetime.timezone.utc)
                   + datetime.timedelta(minutes=m)).astimezone().strftime('%H:%M')
    return f(720 - 4 * (lon + ha) - eqtime), f(720 - 4 * (lon - ha) - eqtime)

# mode flips: light when elev crosses +3° (morning), dark at -6° (evening)
morn, _ = pair(87.0) or (None, None)   # +3° zenith 87
_, eve = pair(96.0) or (None, None)    # -6° zenith 96
print(f'{day}  ({lat}N, {lon}E)  declination {math.degrees(decl):+.1f}°')
print(f'  goes light (elev +3°): {morn or "?"}')
print(f'  goes dark  (elev -6°): {eve or "?"}')
rows = [('sunrise/sunset        ', 90.833)]
for label, z in rows:
    p = pair(z)
    print(f'  {label}: {"  |  ".join(p) if p else "no crossing (polar day/night)"}')
