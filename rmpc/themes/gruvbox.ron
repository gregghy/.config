#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    background_color: "#1d2021",
    text_color: "#ebdbb2",
    header_background_color: "#1d2021",
    modal_background_color: "#3c3836",
    preview_label_style: (fg: "#83a598"),
    preview_metadata_group_style: (fg: "#fabd2f", modifiers: "Bold"),
    highlighted_item_style: (fg: "#83a598", modifiers: "Bold"),
    current_item_style: (fg: "#1d2021", bg: "#83a598", modifiers: "Bold"),
    borders_style: (fg: "#665c54"),
    highlight_border_style: (fg: "#83a598"),
    level_styles: (
        info: (fg: "#83a598", bg: "#1d2021"),
        warn: (fg: "#fabd2f", bg: "#1d2021"),
        error: (fg: "#fb4934", bg: "#1d2021"),
        debug: (fg: "#b8bb26", bg: "#1d2021"),
        trace: (fg: "#d3869b", bg: "#1d2021"),
    ),
    progress_bar: (
        track_style: (fg: "#665c54"),
        elapsed_style: (fg: "#83a598"),
        thumb_style: (fg: "#83a598"),
    ),
    scrollbar: (
        thumb_style: (fg: "#83a598"),
        track_style: (fg: "#665c54"),
    ),
    tab_bar: (
        active_style: (fg: "#1d2021", bg: "#83a598", modifiers: "Bold"),
    ),
)
