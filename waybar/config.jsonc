{
	"layer": "top",
	"position": "top",
	"modules-left": ["clock", "network"],
	"modules-center": ["hyprland/workspaces"],
	"modules-right": ["cpu", "memory", "temperature", "battery", "bluetooth", "pulseaudio", "custom/dnd"],

	"memory": {
    "interval": 30,
    "format": "{}%",
    "on-click": "kitty --class btop -e btop"
  },

	"battery": {
		"format": "{capacity}%{icon}",
		"format-icons": ["", "", "", "", ""],
    "on-click": "kitty --class btop -e btop"
	},

  "clock": {
    "format": "林UX · {:%H:%M   %a %e %b}",
		"tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },

	"pulseaudio": {
        	"format": "{icon} {volume}%",
        	"tooltip": false,
        	"format-muted": " Muted",
        	"on-click": "kitty --class wiremix -e wiremix",
        	"on-click-right": "pamixer -t",
        	"on-scroll-up": "pamixer -i 5",
        	"on-scroll-down": "pamixer -d 5",
        	"scroll-step": 5,
        	"format-icons": {
            		"headphone": "",
            		"hands-free": "",
            		"headset": "",
            		"phone": "",
            		"portable": "",
            		"car": "",
            		"default": ["", "", ""]
        	}
  },

	"temperature": {
        	// k10temp Tctl (AMD CPU die) — same sensor btop reads.
        	// acpitz zones lag ~35°C behind and are meaningless on AMD.
        	"hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
        	"input-filename": "temp1_input",
        	"format": "{temperatureC}°C",
        	"critical-threshold": 90,
        	"format-critical": "{temperatureC}°C",
    "on-click": "kitty --class btop -e btop"
  },

  "cpu": {
		"interval": 2,
		"format": "{usage}%",
    "on-click": "kitty --class btop -e btop"
  },

	"network": {
        // "interface": "wlp2*", // (Optional) To force the use of this interface
        	"format-wifi": " {signalStrength}%",
        	"format-ethernet": "{ipaddr}/{cidr}",
        	"tooltip-format": "{essid} - {ifname} via {gwaddr}",
        	"format-linked": "{ifname} (No IP)",
        	"format-disconnected": "Disconnected ⚠",
        	"format-alt": "{ifname}:{essid} {ipaddr}/{cidr}",
        	"on-click": "kitty --class impala -e impala"
    	},
	"bluetooth": {
        	"format": "",
        	"format-disabled": " off",
        	"format-off": " off",
        	"format-connected": " {device_alias}",
        	"format-connected-battery": " {device_alias} {device_battery_percentage}%",
        	"tooltip-format": "{controller_alias}\n{num_connections} connected",
        	"on-click": "kitty --class bluetui -e bluetui"
    	},

	"custom/dnd": {
		"exec": "~/.config/waybar/scripts/dnd-status",
		"return-type": "json",
		"interval": "once",
		"signal": 8,
		"on-click": "~/.config/waybar/scripts/dnd-toggle"
	},

	"hyprland/workspaces": {
		"format": "{id}"
	}
}

